<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Keep Cooking</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<!-- Release plumbing: stamped via project-level MARKETING_VERSION
	     (project.yml). Re-apply by hand after any `xcodegen generate`. -->
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<!-- Release plumbing: stamped via project-level CURRENT_PROJECT_VERSION
	     (project.yml) / Xcode Cloud $CI_BUILD_NUMBER. Re-apply by hand
	     after any `xcodegen generate`. -->
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo of a cookbook page to scan its text.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a photo of a cookbook page to scan its text.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>SMIDGEN_API_BASE_URL</key>
	<string>$(SMIDGEN_API_BASE_URL)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Listen for hands-free cook commands while the recipe is on screen.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Recognize cook commands like Next step on-device.</string>
	<!-- NOTE (project.yml): `xcodegen generate` rewrites Config plists from
	     scratch — re-apply the two keys above by hand after any regen. -->
	<!-- Share extension "Open in Keep Cooking": smidgen://clip?url=<pct-encoded>.
	     Regen-safe mirror lives in project.yml KeepCooking info.properties. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.smidgen.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>smidgen</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
